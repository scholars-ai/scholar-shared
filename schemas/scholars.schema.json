{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/scholars-ai/scholar-shared/schemas/scholars.schema.json",
  "title": "ScholarsContracts",
  "description": "scholars-ai 契约单一事实来源（SPEC-002 实体 / SPEC-001§3 job / SPEC-004 rubric 结构）。修改本文件后必须运行 scripts/generate.sh 重新生成三端代码。",
  "type": "object",
  "definitions": {
    "Platform": {
      "description": "发布平台。新增平台专家时在此扩展（SPEC-005 §3）",
      "type": "string",
      "enum": ["xiaohongshu", "zhihu", "wechat"]
    },
    "ArticleFormat": {
      "description": "文章输出格式，第一阶段仅 markdown（SPEC-000 §4）",
      "type": "string",
      "enum": ["markdown"]
    },
    "SourceType": {
      "type": "string",
      "enum": ["rss", "rsshub", "manual", "crawler"]
    },
    "SourceCategory": {
      "type": "string",
      "enum": ["news", "research", "tutorial", "kol"]
    },
    "RawItemStatus": {
      "type": "string",
      "enum": ["new", "clustered", "discarded"]
    },
    "TopicStatus": {
      "description": "选题状态机（SPEC-002 §3），流转只由 core 执行",
      "type": "string",
      "enum": ["candidate", "scored", "approved", "in_writing", "written", "rejected"]
    },
    "ArticleStatus": {
      "description": "文章状态机（SPEC-002 §3）",
      "type": "string",
      "enum": ["draft", "scored", "rewrite_queued", "pending_review", "approved", "published", "rejected"]
    },
    "MetricSource": {
      "type": "string",
      "enum": ["manual", "import", "api"]
    },
    "MetricWindow": {
      "description": "标准表现采样窗口；custom 不参与平台百分位比较",
      "type": "string",
      "enum": ["h24", "h72", "d7", "custom"]
    },
    "InsightKind": {
      "description": "反思经验类别（SPEC-006 §4）",
      "type": "string",
      "enum": ["topic_lesson", "writing_lesson", "platform_lesson", "source_lesson"]
    },
    "InsightStatus": {
      "description": "candidate=孤证待验，active=生效，retired=被后续数据推翻（SPEC-006 §6）",
      "type": "string",
      "enum": ["candidate", "active", "retired"]
    },
    "AgentRunStatus": {
      "type": "string",
      "enum": ["running", "succeeded", "failed"]
    },
    "WorkflowRunStatus": {
      "description": "一次完整内容生产运行的状态（SPEC-010 §3.3）",
      "type": "string",
      "enum": ["queued", "running", "waiting_human_review", "completed", "completed_empty", "partial_failed", "failed", "cancelled"]
    },
    "WorkflowNodeKey": {
      "type": "string",
      "enum": ["source_fetch", "topic_scout", "topic_evaluate", "article_write", "article_evaluate", "human_review"]
    },
    "WorkflowNodeStatus": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "partial_failed", "failed", "skipped", "cancelled"]
    },
    "WorkflowTriggerType": {
      "type": "string",
      "enum": ["scheduled", "manual", "replay"]
    },
    "WorkflowDecision": {
      "type": "string",
      "enum": ["accepted", "rejected", "skipped", "failed"]
    },
    "WorkflowItemType": {
      "type": "string",
      "enum": ["raw_item", "topic", "article"]
    },
    "WorkflowRunMode": {
      "type": "string",
      "enum": ["content_production"]
    },
    "WorkflowRunSummary": {
      "description": "动态漏斗聚合；数字是本次运行观测值，不是业务配额",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "reasonCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "WorkflowNodeRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "nodeKey", "status", "inputSnapshotId", "outputSnapshotId", "configSnapshot", "counts", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "nodeKey": { "$ref": "#/definitions/WorkflowNodeKey" },
        "status": { "$ref": "#/definitions/WorkflowNodeStatus" },
        "inputSnapshotId": { "type": ["string", "null"], "format": "uuid" },
        "outputSnapshotId": { "type": ["string", "null"], "format": "uuid" },
        "configSnapshot": { "type": "object", "additionalProperties": true },
        "counts": { "$ref": "#/definitions/WorkflowRunSummary" },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "WorkflowItemDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "nodeRunId", "itemId", "itemType", "decision", "reasonCode", "reason", "inputRefs", "evidenceRefs", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "nodeRunId": { "type": "string", "format": "uuid" },
        "itemId": { "type": "string", "format": "uuid" },
        "itemType": { "$ref": "#/definitions/WorkflowItemType" },
        "decision": { "$ref": "#/definitions/WorkflowDecision" },
        "reasonCode": { "type": "string" },
        "reason": { "type": "string" },
        "dimensionScores": { "type": ["object", "null"], "additionalProperties": { "type": "number" } },
        "totalScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "threshold": { "type": ["number", "null"] },
        "weightVersion": { "type": ["integer", "null"], "minimum": 1 },
        "rubricVersion": { "type": ["string", "null"] },
        "inputRefs": { "type": "object", "additionalProperties": true },
        "evidenceRefs": { "type": "object", "additionalProperties": true },
        "agentRunId": { "type": ["string", "null"], "format": "uuid" },
        "traceId": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkflowArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "nodeKey", "artifactType", "artifactId", "title", "metadata", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "nodeKey": { "$ref": "#/definitions/WorkflowNodeKey" },
        "artifactType": { "$ref": "#/definitions/WorkflowItemType" },
        "artifactId": { "type": "string", "format": "uuid" },
        "parentArtifactId": { "type": ["string", "null"], "format": "uuid" },
        "title": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkflowSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runId", "kind", "payload", "sha256", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "kind": { "type": "string", "enum": ["definition", "input", "output", "config"] },
        "payload": { "type": "object", "additionalProperties": true },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "archivedAt": { "type": ["string", "null"], "format": "date-time" },
        "storageRef": { "type": ["string", "null"] },
        "retentionUntil": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkflowConfigSnapshot": {
      "description": "配置快照 payload；由 Core 固化并由 replay 继承。",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "configVersion", "workflowVersion", "triggerType", "overrides", "requestedOverrides", "effective", "resolution"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "configVersion": { "type": "string", "minLength": 1 },
        "workflowVersion": { "type": "string", "minLength": 1 },
        "triggerType": { "$ref": "#/definitions/WorkflowTriggerType" },
        "overrides": { "type": "object", "additionalProperties": true },
        "requestedOverrides": { "type": "object", "additionalProperties": true },
        "effective": { "type": "object", "additionalProperties": true },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "resolvedBy", "agentOwned"],
          "properties": {
            "status": { "type": "string", "enum": ["validated"] },
            "resolvedBy": { "type": "string", "enum": ["core"] },
            "agentOwned": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "Source": {
      "description": "信源（SPEC-003 §2）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "url", "category", "weight", "enabled", "fetchConfig"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/definitions/SourceType" },
        "url": { "type": ["string", "null"] },
        "category": { "$ref": "#/definitions/SourceCategory" },
        "weight": { "description": "信源质量权重 0–1，被反馈闭环校准（SPEC-006 §5）", "type": "number", "minimum": 0, "maximum": 1 },
        "enabled": { "type": "boolean" },
        "fetchConfig": { "$ref": "#/definitions/SourceFetchConfig" }
      }
    },
    "SourceFetchConfig": {
      "description": "单个信源的采集配置（SPEC-008 §3.1）。intervalMinutes 为空表示沿用全局默认；不为空即覆盖全局。additionalProperties 保持开放以便加源专属开关而不破契约。",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "role": { "$ref": "#/definitions/SourceRole" },
        "fullText": { "$ref": "#/definitions/FullTextStrategy" },
        "maxItems": { "description": "单次采集条目上限。arXiv 类源单次返回数百条，必须限量", "type": "integer", "minimum": 1, "maximum": 500 },
        "maxAgeDays": { "description": "早于此天数的条目直接丢弃且不做 embedding（省额度）", "type": "integer", "minimum": 1, "maximum": 365 },
        "intervalMinutes": { "description": "覆盖全局采集间隔；null/缺省=沿用全局默认（SPEC-008 §3.1）", "type": ["integer", "null"], "minimum": 5, "maximum": 10080 }
      }
    },
    "SourceRole": {
      "description": "material=能拿到原文，可作写作素材；signal=只有二手摘要，仅供发现（SPEC-003 §2.1）",
      "type": "string",
      "enum": ["material", "signal"]
    },
    "FullTextStrategy": {
      "description": "rss_description=RSS 自带正文足够；fetch_page=需抓原文页（trafilatura）",
      "type": "string",
      "enum": ["rss_description", "fetch_page"]
    },
    "RawItem": {
      "description": "原始采集条目",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "title", "url", "author", "content", "publishedAt", "contentHash", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sourceId": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "content": { "description": "清洗后的正文（markdown/纯文本）", "type": "string" },
        "publishedAt": { "type": ["string", "null"], "format": "date-time" },
        "contentHash": { "type": "string" },
        "status": { "$ref": "#/definitions/RawItemStatus" }
      }
    },
    "Topic": {
      "description": "选题（素材之上的创作视角，SPEC-003 §4）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "angle", "summary", "rawItemIds", "targetPlatforms", "status", "latestScore"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "title": { "type": "string", "minLength": 1 },
        "angle": { "description": "切入角度描述", "type": "string" },
        "summary": { "description": "选题简介 + 素材要点", "type": "string" },
        "rawItemIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "targetPlatforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Platform" } },
        "status": { "$ref": "#/definitions/TopicStatus" },
        "latestScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "EvaluationCore": {
      "description": "评分记录公共结构（SPEC-004 §1）。dimensionScores: 维度 key → 0–10 分",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rubricVersion", "dimensionScores", "dimensionReasons", "totalScore", "rationale", "judgeModel", "agentRunId"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "rubricVersion": { "description": "如 topic@v1 / article/xiaohongshu@v3", "type": "string", "minLength": 1 },
        "dimensionScores": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 10 } },
        "dimensionReasons": { "description": "维度 key → 具体评分理由", "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "totalScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "rationale": { "description": "人可读的评审理由", "type": "string", "minLength": 1 },
        "judgeModel": { "type": "string" },
        "agentRunId": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "TopicEvaluation": {
      "allOf": [
        { "$ref": "#/definitions/EvaluationCore" },
        {
          "type": "object",
          "required": ["topicId"],
          "properties": {
            "topicId": { "type": "string", "format": "uuid" },
            "weightVersion": { "description": "评分时生效的 weight_sets.version，用于历史回放", "type": ["integer", "null"], "minimum": 1 },
            "vetoedDimension": { "description": "触发一票否决的维度；没有 veto 时为空", "type": ["string", "null"] }
          }
        }
      ]
    },
    "ArticleEvaluation": {
      "allOf": [
        { "$ref": "#/definitions/EvaluationCore" },
        {
          "type": "object",
          "required": ["articleId", "passThreshold", "passed"],
          "properties": {
            "articleId": { "type": "string", "format": "uuid" },
            "weightVersion": { "description": "评分时生效的 weight_sets.version", "type": ["integer", "null"], "minimum": 1 },
            "vetoedDimension": { "description": "触发一票否决的维度；没有 veto 时为空", "type": ["string", "null"] },
            "passThreshold": { "description": "本次 rubric 的过审线", "type": "number", "minimum": 0, "maximum": 100 },
            "passed": { "description": "确定性代码按总分和 veto 计算的最终判定", "type": "boolean" }
          }
        }
      ]
    },
    "ArticleAsset": {
      "description": "文章资产（配图/封面），M3+ 启用（SPEC-005 §4）",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "url"],
      "properties": {
        "role": { "type": "string", "enum": ["cover", "inline"] },
        "url": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "Article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topicId", "platform", "version", "format", "title", "contentMd", "assets", "writerAgent", "status", "latestScore"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "topicId": { "type": "string", "format": "uuid" },
        "platform": { "$ref": "#/definitions/Platform" },
        "version": { "description": "同一 topic+platform 的重写版本号，从 1 起", "type": "integer", "minimum": 1 },
        "previousArticleId": { "description": "回炉前一版本；首版为空。文章版本不可变，新版本另建一行。", "type": ["string", "null"], "format": "uuid" },
        "format": { "$ref": "#/definitions/ArticleFormat" },
        "title": { "type": "string", "minLength": 1 },
        "contentMd": { "type": "string", "minLength": 1 },
        "assets": { "type": "array", "items": { "$ref": "#/definitions/ArticleAsset" } },
        "writerAgent": { "description": "产出它的专家 Agent 标识 + prompt 版本，如 writer/xiaohongshu@v2", "type": "string" },
        "status": { "$ref": "#/definitions/ArticleStatus" },
        "latestScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "Publication": {
      "description": "发布记录（人工发布后登记）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "articleId", "platform", "platformPostId", "publishedAt", "finalContentDiff", "editRatio", "followerCountAtPublish"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "articleId": { "type": "string", "format": "uuid" },
        "platform": { "$ref": "#/definitions/Platform" },
        "platformPostId": { "type": ["string", "null"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "finalContentDiff": { "description": "人工发布前的修改 diff，衡量人工修改量指标", "type": ["string", "null"] },
        "editRatio": { "description": "Core 按标题 + Markdown 正文的字符级编辑距离确定性计算，范围 0–1", "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "followerCountAtPublish": { "description": "发布时账号粉丝数，表现分基数修正用（SPEC-006 §3）", "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "EngagementMetrics": {
      "description": "平台指标，各平台字段不齐，缺失置 null",
      "type": "object",
      "additionalProperties": false,
      "required": ["views", "likes", "favorites", "comments", "shares", "follows"],
      "properties": {
        "views": { "type": ["integer", "null"], "minimum": 0 },
        "likes": { "type": ["integer", "null"], "minimum": 0 },
        "favorites": { "type": ["integer", "null"], "minimum": 0 },
        "comments": { "type": ["integer", "null"], "minimum": 0 },
        "shares": { "type": ["integer", "null"], "minimum": 0 },
        "follows": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "MetricSnapshot": {
      "description": "数据快照，同一发布多次采样看增长曲线（24h/72h/7d，SPEC-006 §2）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publicationId", "capturedAt", "snapshotWindow", "metrics", "source", "performanceRaw", "performancePercentile", "performanceWeightVersion"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "publicationId": { "type": "string", "format": "uuid" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "snapshotWindow": { "$ref": "#/definitions/MetricWindow" },
        "metrics": { "$ref": "#/definitions/EngagementMetrics" },
        "source": { "$ref": "#/definitions/MetricSource" },
        "performanceRaw": { "type": "number", "minimum": 0 },
        "performancePercentile": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "performanceWeightVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "InsightEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["articleIds", "publicationIds", "note"],
      "properties": {
        "articleIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "publicationIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "note": { "description": "数据摘要，如：标题含数字的 5 篇 24h 收藏率均值 2.3x", "type": "string", "minLength": 1 }
      }
    },
    "Insight": {
      "description": "反思产出的经验条目。必须可执行且有证据（SPEC-006 §4：evidence 非空）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "platform", "content", "evidence", "confidence", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "$ref": "#/definitions/InsightKind" },
        "platform": {
          "oneOf": [{ "$ref": "#/definitions/Platform" }, { "type": "null" }]
        },
        "content": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/InsightEvidence" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/definitions/InsightStatus" }
      }
    },
    "ReflectorInsightDraft": {
      "description": "Reflector 的结构化建议；确定性代码负责最终状态护栏和数据库更新",
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "existingInsightId", "kind", "platform", "content", "evidence", "confidence"],
      "properties": {
        "action": { "type": "string", "enum": ["create", "support", "contradict"] },
        "existingInsightId": { "type": ["string", "null"], "format": "uuid" },
        "kind": { "$ref": "#/definitions/InsightKind" },
        "platform": { "oneOf": [{ "$ref": "#/definitions/Platform" }, { "type": "null" }] },
        "content": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/InsightEvidence" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "MemoryReflectOutput": {
      "description": "memory.reflect 的 LLM 输出；统计与相关性不由模型计算",
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryMarkdown", "insights"],
      "properties": {
        "summaryMarkdown": { "type": "string", "minLength": 1 },
        "insights": { "type": "array", "items": { "$ref": "#/definitions/ReflectorInsightDraft" } }
      }
    },
    "WeeklyReport": {
      "description": "每周反思与评分校准报告",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "periodStart", "periodEnd", "sampleCount", "summaryMarkdown", "calibration", "agentRunId", "createdAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "periodStart": { "type": "string", "format": "date-time" },
        "periodEnd": { "type": "string", "format": "date-time" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "summaryMarkdown": { "type": "string" },
        "calibration": { "type": "object", "additionalProperties": true },
        "agentRunId": { "type": ["string", "null"], "format": "uuid" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AgentRun": {
      "description": "Agent 运行留痕（成本/溯源，SPEC-002）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "jobType", "entityType", "entityId", "langfuseTraceId", "model", "promptVersion", "tokensIn", "tokensOut", "costUsd", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "jobType": { "type": "string" },
        "entityType": { "type": ["string", "null"] },
        "entityId": { "type": ["string", "null"], "format": "uuid" },
        "langfuseTraceId": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "promptVersion": { "type": ["string", "null"] },
        "tokensIn": { "type": ["integer", "null"], "minimum": 0 },
        "tokensOut": { "type": ["integer", "null"], "minimum": 0 },
        "costUsd": { "type": ["number", "null"], "minimum": 0 },
        "status": { "$ref": "#/definitions/AgentRunStatus" }
      }
    },

    "JobTelemetryMeta": {
      "description": "跨队列传播的可选遥测元数据。旧消息可以不包含 _meta；Consumer 缺失时创建新的 root trace。",
      "type": "object",
      "additionalProperties": false,
      "required": ["jobId", "correlationId", "enqueuedAt", "triggerType"],
      "properties": {
        "jobId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": "string", "format": "uuid" },
        "parentJobId": { "type": ["string", "null"], "format": "uuid" },
        "traceparent": { "type": ["string", "null"] },
        "tracestate": { "type": ["string", "null"] },
        "baggage": { "type": ["string", "null"] },
        "enqueuedAt": { "type": "string", "format": "date-time" },
        "triggerType": {
          "type": "string",
          "enum": ["api", "scheduler", "harvester", "worker", "replay"]
        }
      }
    },

    "TopicEvaluateJob": {
      "description": "queue: topic_evaluate（SPEC-001 §3。队列名注册表见 queues.json）",
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId"],
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "topicId": { "type": "string", "format": "uuid" },
        "workflowRunId": { "type": ["string", "null"], "format": "uuid", "description": "生产工作流运行 ID；诊断任务可缺省" },
        "rubricVersion": { "description": "缺省用当前生效版本", "type": "string" },
        "workflowConfigOverrides": { "$ref": "#/definitions/WorkflowConfigOverrides" }
      }
    },
    "RewriteContext": {
      "description": "回炉重写上下文（SPEC-005 §2）",
      "type": "object",
      "additionalProperties": false,
      "required": ["previousArticleId", "evaluationFeedback", "redoOutline"],
      "properties": {
        "previousArticleId": { "type": "string", "format": "uuid" },
        "evaluationFeedback": { "type": "string", "minLength": 1 },
        "redoOutline": { "description": "结构维度不达标时才重跑大纲", "type": "boolean" }
      }
    },
    "ArticleWriteJob": {
      "description": "queue: article_write",
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "platform"],
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "topicId": { "type": "string", "format": "uuid" },
        "platform": { "$ref": "#/definitions/Platform" },
        "workflowRunId": { "type": ["string", "null"], "format": "uuid", "description": "生产工作流运行 ID；诊断任务可缺省" },
        "replay": { "type": "boolean", "description": "节点回放写作；生成新的文章版本而不复用父运行文章" },
        "rewrite": { "$ref": "#/definitions/RewriteContext" },
        "workflowConfigOverrides": { "$ref": "#/definitions/WorkflowConfigOverrides" }
      }
    },
    "ArticleEvaluateJob": {
      "description": "queue: article_evaluate",
      "type": "object",
      "additionalProperties": false,
      "required": ["articleId"],
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "articleId": { "type": "string", "format": "uuid" },
        "workflowRunId": { "type": ["string", "null"], "format": "uuid", "description": "生产工作流运行 ID；诊断任务可缺省" },
        "rubricVersion": { "type": "string" },
        "workflowConfigOverrides": { "$ref": "#/definitions/WorkflowConfigOverrides" }
      }
    },
    "WorkflowConfigOverrides": {
      "description": "Replay 节点的显式配置覆盖；未知字段禁止传入",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentVersion": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 },
        "rubricVersion": { "type": "string", "minLength": 1 },
        "topicRubricVersion": { "type": "string", "minLength": 1 },
        "articleRubricVersion": { "type": "string", "minLength": 1 },
        "weightVersion": { "type": "integer", "minimum": 1 },
        "topicWeightVersion": { "type": "integer", "minimum": 1 },
        "articleWeightVersion": { "type": "integer", "minimum": 1 },
        "model": { "type": "string", "minLength": 1 },
        "topicScoutModel": { "type": "string", "minLength": 1 },
        "topicJudgeModel": { "type": "string", "minLength": 1 },
        "outlineModel": { "type": "string", "minLength": 1 },
        "draftModel": { "type": "string", "minLength": 1 },
        "criticModel": { "type": "string", "minLength": 1 },
        "articleJudgeModel": { "type": "string", "minLength": 1 },
        "passThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "topicPassThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "articlePassThreshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxBatchSize": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "SourceFetchJob": {
      "description": "queue: source_fetch（core cron 投递，agents 采集，SPEC-003 §3）",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "sourceId": { "type": "string", "format": "uuid" },
        "workflowRunId": { "type": ["string", "null"], "format": "uuid", "description": "生产工作流运行 ID；诊断任务可缺省" },
        "cascade": { "type": "boolean", "description": "历史兼容字段；生产工作流使用 workflowRunId" },
        "url": { "description": "手动投喂时只抓取这一条 URL；普通 source_fetch 不传", "type": ["string", "null"], "format": "uri" },
        "note": { "description": "手动投喂备注，供留痕使用", "type": ["string", "null"] }
      }
    },
    "TopicScoutJob": {
      "description": "queue: topic_scout（聚合 status=new 的素材为选题，SPEC-003 §4；rawItemIds 用于手动投喂定向处理）",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "workflowRunId": { "type": ["string", "null"], "format": "uuid", "description": "生产工作流运行 ID；诊断任务可缺省" },
        "maxTopics": { "type": "integer", "minimum": 1 },
        "rawItemIds": {
          "description": "仅处理指定的 new 素材；手动投喂链路使用",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    },
    "MemoryReflectJob": {
      "description": "queue: memory_reflect（SPEC-006 §4；periodStart 含、periodEnd 不含）",
      "type": "object",
      "additionalProperties": false,
      "required": ["periodStart", "periodEnd"],
      "properties": {
        "_meta": { "$ref": "#/definitions/JobTelemetryMeta" },
        "periodStart": { "type": "string", "format": "date-time" },
        "periodEnd": { "type": "string", "format": "date-time" }
      }
    },
    "JobResult": {
      "description": "worker 回报结构：core 据此收割结果并推进状态机",
      "type": "object",
      "additionalProperties": false,
      "required": ["agentRunId", "entityIds", "langfuseTraceId"],
      "properties": {
        "agentRunId": { "type": "string", "format": "uuid" },
        "entityIds": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "langfuseTraceId": { "type": ["string", "null"] }
      }
    },

    "SchedulerSettings": {
      "description": "全局调度设置（SPEC-008 §3.1）。存 DB、由 client 修改；DEFAULT_* 环境变量只用于首次 seed，运行时真相只在 DB。",
      "type": "object",
      "additionalProperties": false,
      "required": ["contentWorkflow", "sourceFetch", "topicScout", "topicEvaluate", "articleWrite", "memoryReflect", "workflowSnapshots"],
      "properties": {
        "contentWorkflow": { "$ref": "#/definitions/ContentWorkflowSchedule" },
        "sourceFetch": { "$ref": "#/definitions/SourceFetchSchedule" },
        "topicScout": { "$ref": "#/definitions/TopicScoutSchedule" },
        "topicEvaluate": { "$ref": "#/definitions/TopicEvaluateSchedule" },
        "articleWrite": { "$ref": "#/definitions/ArticleWriteSchedule" },
        "memoryReflect": { "$ref": "#/definitions/MemoryReflectSchedule" },
        "workflowSnapshots": { "$ref": "#/definitions/WorkflowSnapshotRetentionSchedule" }
      }
    },
    "ContentWorkflowSchedule": {
      "description": "内容生产工作流调度：按固定小时间隔创建完整 WorkflowRun",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "intervalHours"],
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalHours": { "type": "integer", "minimum": 1, "maximum": 168 }
      }
    },
    "SourceFetchSchedule": {
      "description": "采集调度：全局默认间隔，可被 sources.fetchConfig.intervalMinutes 逐源覆盖",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "defaultIntervalMinutes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultIntervalMinutes": { "description": "下限 5 分钟：防止误配成高频轮询触发上游限流（RSSHub / X 尤其敏感）", "type": "integer", "minimum": 5, "maximum": 10080 }
      }
    },
    "TopicScoutSchedule": {
      "description": "选题聚合调度：按每日固定时刻触发",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "times", "timezone", "minNewItems"],
      "properties": {
        "enabled": { "type": "boolean" },
        "times": {
          "description": "每日执行时刻（HH:MM，24 小时制）。client 用表单生成，不让用户手写 cron 表达式",
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        },
        "timezone": { "description": "IANA 时区名，如 Asia/Shanghai", "type": "string", "minLength": 1 },
        "minNewItems": { "description": "新素材不足此数则跳过本次运行并留痕（避免为几条素材烧一次 LLM）", "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "TopicEvaluateSchedule": {
      "description": "评分调度：**事件驱动**，candidate 产生即投递，不设固定时刻（SPEC-008 §3.1 纪律 2）",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxConcurrency"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "ArticleWriteSchedule": {
      "description": "平台文章生成调度：按每日固定时刻，自动选择最高分 scored Topic 并进入写作链路。",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "times", "timezone", "maxTopics"],
      "properties": {
        "enabled": { "type": "boolean" },
        "times": {
          "description": "每日执行时刻（HH:MM，24 小时制）",
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
        },
        "timezone": { "description": "IANA 时区名，如 Asia/Shanghai", "type": "string", "minLength": 1 },
        "maxTopics": { "description": "单次自动进入写作链路的最高分 Topic 数量", "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "MemoryReflectSchedule": {
      "description": "每周反思调度；weekday 使用 ISO 周序号 1=周一…7=周日",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "weekday", "time", "timezone", "lookbackDays"],
      "properties": {
        "enabled": { "type": "boolean" },
        "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
        "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timezone": { "type": "string", "minLength": 1 },
        "lookbackDays": { "type": "integer", "minimum": 1, "maximum": 90 }
      }
    },
    "WorkflowSnapshotRetentionSchedule": {
      "description": "工作流输入输出快照保留策略；到期后只归档元数据，payload、checksum 和血缘仍可恢复。",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "retentionHours", "batchSize"],
      "properties": {
        "enabled": { "type": "boolean" },
        "retentionHours": { "description": "快照创建后保留时长（小时）", "type": "integer", "minimum": 1, "maximum": 8760 },
        "batchSize": { "description": "每个 scheduler tick 最多归档的快照数", "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "SourceHealth": {
      "description": "信源采集健康状态（client 信源管理页展示；连续失败需告警）",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "lastRunAt", "lastSuccessAt", "consecutiveFailures", "lastError", "nextRunAt"],
      "properties": {
        "sourceId": { "type": "string", "format": "uuid" },
        "lastRunAt": { "type": ["string", "null"], "format": "date-time" },
        "lastSuccessAt": { "type": ["string", "null"], "format": "date-time" },
        "consecutiveFailures": { "type": "integer", "minimum": 0 },
        "lastError": { "type": ["string", "null"] },
        "nextRunAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "TopicJudgeOutput": {
      "description": "TopicJudge 的结构化输出契约（供 runtime.complete_structured 校验）。**维度 key 必须与 rubrics/topic.v1.yaml 完全一致**——rubric 是唯一事实来源，此处不得另立一套。totalScore 由代码按生效权重重算，不信任模型自报（SPEC-004 §1.2）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionScores", "rationale"],
      "properties": {
        "dimensionScores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeliness", "audience_value", "platform_fit", "differentiation", "material_richness", "history_signal"],
          "properties": {
            "timeliness": { "$ref": "#/definitions/DimensionScore" },
            "audience_value": { "$ref": "#/definitions/DimensionScore" },
            "platform_fit": { "$ref": "#/definitions/DimensionScore" },
            "differentiation": { "$ref": "#/definitions/DimensionScore" },
            "material_richness": { "$ref": "#/definitions/DimensionScore" },
            "history_signal": { "$ref": "#/definitions/DimensionScore" }
          }
        },
        "rationale": { "description": "人可读的总体评审理由：评分不可信时人要能一眼看出是 rubric 问题还是模型问题（SPEC-004 §1.5）", "type": "string", "minLength": 1 },
        "suggestedPlatforms": {
          "description": "Judge 认为该选题更适合的平台（可与 TopicScout 的建议不同）",
          "type": "array",
          "items": { "$ref": "#/definitions/Platform" }
        }
      }
    },
    "DimensionScore": {
      "description": "单维度评分：分数 + 该维度的具体理由（强制逐维给理由，抑制笼统打分）",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "TopicScoutOutput": {
      "description": "TopicScout 的结构化输出契约：一簇素材 → 1–3 个选题角度（SPEC-003 §4）",
      "type": "object",
      "additionalProperties": false,
      "required": ["topics"],
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/TopicDraft" }
        },
        "discardReason": { "description": "本簇未产出任何选题时的原因（留痕，便于调 prompt）", "type": "string" }
      }
    },
    "TopicDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "angle", "summary", "rawItemIds", "targetPlatforms"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "angle": { "description": "切入角度：同一事件对小红书和知乎的写法角度可能完全不同", "type": "string", "minLength": 1 },
        "summary": { "description": "选题简介 + 素材要点", "type": "string", "minLength": 1 },
        "rawItemIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } },
        "targetPlatforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Platform" } }
      }
    },
    "PlatformHardConstraints": {
      "description": "平台可由确定性 Formatter 检查的硬约束（SPEC-005 §3）",
      "type": "object",
      "additionalProperties": false,
      "required": ["minCharacters", "maxCharacters", "titleMaxCharacters", "minTags", "maxTags", "minImagePlaceholders"],
      "properties": {
        "minCharacters": { "type": "integer", "minimum": 1 },
        "maxCharacters": { "type": "integer", "minimum": 1 },
        "titleMaxCharacters": { "type": "integer", "minimum": 1 },
        "minTags": { "type": "integer", "minimum": 0 },
        "maxTags": { "type": "integer", "minimum": 0 },
        "minImagePlaceholders": { "type": "integer", "minimum": 0 }
      }
    },
    "PlatformProfile": {
      "description": "平台专家的声明式档案；新增平台只新增 profile + rubric（SPEC-005 §3）",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "platform", "voice", "structureTemplate", "hardConstraints", "styleRules", "rubricRef", "exemplars"],
      "properties": {
        "id": { "type": "string", "pattern": "^platform/[a-z0-9_-]+$" },
        "version": { "type": "string", "pattern": "^v[0-9]+$" },
        "platform": { "$ref": "#/definitions/Platform" },
        "voice": { "type": "string", "minLength": 1 },
        "structureTemplate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "hardConstraints": { "$ref": "#/definitions/PlatformHardConstraints" },
        "styleRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rubricRef": { "type": "string", "pattern": "^article/[a-z0-9_-]+@v[0-9]+$" },
        "exemplars": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "RubricAnchor": {
      "description": "锚定样例：抑制 LLM 评分中心化（SPEC-004 §1.3）",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "example", "why"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "example": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 }
      }
    },
    "RubricDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "description", "initialWeight", "anchors", "vetoBelow"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "initialWeight": { "description": "初始权重；生效权重存 DB（WeightSet），由校准环节调整（SPEC-004 §4）", "type": "number", "minimum": 0, "maximum": 1 },
        "anchors": { "type": "array", "items": { "$ref": "#/definitions/RubricAnchor" } },
        "vetoBelow": { "description": "一票否决线：任一维度低于此分整体不通过，不参与加权（如文章 accuracy<6，SPEC-004 §3）", "type": ["number", "null"], "minimum": 0, "maximum": 10 }
      }
    },
    "RubricDefinition": {
      "description": "rubric 定义（rubrics/*.yaml 的结构约束）。完整版本号 = {id}@{version}",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "dimensions", "passThreshold"],
      "properties": {
        "id": { "description": "如 topic / article/xiaohongshu", "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v[0-9]+$" },
        "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/RubricDimension" } },
        "passThreshold": { "description": "总分阈值：选题推荐线/文章过审线", "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "WeightSet": {
      "description": "校准后的生效权重（存 DB，版本递增，人工确认后生效，SPEC-004 §4）",
      "type": "object",
      "additionalProperties": false,
      "required": ["rubricId", "version", "weights", "note"],
      "properties": {
        "rubricId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "weights": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
        "note": { "type": "string" }
      }
    },
    "PerformanceWeights": {
      "description": "表现分 P 的平台权重（SPEC-006 §3），定义见 rubrics/performance-weights.v1.yaml",
      "type": "object",
      "additionalProperties": false,
